# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Pipeline outputs
outputs/
*.log

# Pytest scratch (per pytest.ini basetemp). The glob also covers the
# suffixed basetemps individual test runs use (.pytest_tmp_config,
# .pytest_tmp_fast, …) so per-run scratch dirs never show up as untracked.
.pytest_tmp*
.pytest_cache/
# Coverage artifacts (pytest-cov / --cov-fail-under in CI).
.coverage
.coverage.*
coverage.xml
htmlcov/
.testmondata*
tstex_modules/
tools/
.claude/

# Local secrets (Brave / CORE API keys, etc.) — never commit
.env
.env.*
